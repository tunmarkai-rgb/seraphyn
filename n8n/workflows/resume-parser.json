        "inputSchema": "{\n  \"full_name\": \"\",\n  \"first_name\": \"\",\n  \"last_name\": \"\",\n  \"email\": \"\",\n  \"phone\": \"\",\n  \"specialty\": \"\",\n  \"license_number\": \"\",\n  \"license_state\": \"\",\n  \"years_experience\": 0,\n  \"availability\": \"\",\n  \"shift_preference\": \"\",\n  \"bio\": \"\",\n  \"certifications\": [\"\"],\n  \"skills\": [\"\"],\n  \"summary\": \"\",\n  \"confidence_notes\": \"\"\n}"
