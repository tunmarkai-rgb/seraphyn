    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const base = $('Prepare Resume Prompt').first().json;\nconst payload = $input.first().json;\n\nconst parsed = payload.output?.output || payload.output || payload.result || payload.json || payload;\n\nconst normalizeString = (value) => {\n  if (value === null || value === undefined) return null;\n  const text = String(value).trim();\n  return text ? text : null;\n};\n\nconst normalizeArray = (value) => Array.isArray(value)\n  ? value.map((entry) => normalizeString(entry)).filter(Boolean)\n  : [];\n\nconst normalized = {\n  full_name: normalizeString(parsed.full_name),\n  first_name: normalizeString(parsed.first_name),\n  last_name: normalizeString(parsed.last_name),\n  email: normalizeString(parsed.email),\n  phone: normalizeString(parsed.phone),\n  specialty: normalizeString(parsed.specialty),\n  license_number: normalizeString(parsed.license_number),\n  license_state: normalizeString(parsed.license_state),\n  years_experience: Number.isInteger(parsed.years_experience) ? parsed.years_experience : null,\n  availability: normalizeString(parsed.availability),\n  shift_preference: normalizeString(parsed.shift_preference),\n  bio: normalizeString(parsed.bio),\n  certifications: normalizeArray(parsed.certifications),\n  skills: normalizeArray(parsed.skills),\n  summary: normalizeString(parsed.summary),\n  confidence_notes: normalizeString(parsed.confidence_notes)\n};\n\nconst profile = base.nurseProfile || {};\nconst existingCerts = normalizeArray(profile.certifications);\n\nconst updatePayload = {\n  ai_parsed_data: {\n    parsed_at: new Date().toISOString(),\n    source: 'n8n.resume_parser',\n    file_name: base.fileName,\n    file_extension: base.extension,\n    public_resume_url: base.publicResumeUrl,\n    text_length: base.extractedTextLength,\n    model: 'claude-3-5-haiku-20241022',\n    parsed: normalized\n  }\n};\n\nif (!profile.first_name && normalized.first_name) updatePayload.first_name = normalized.first_name;\nif (!profile.last_name && normalized.last_name) updatePayload.last_name = normalized.last_name;\nif (!profile.specialty && normalized.specialty) updatePayload.specialty = normalized.specialty;\nif (!profile.license_number && normalized.license_number) updatePayload.license_number = normalized.license_number;\nif (!profile.license_state && normalized.license_state) updatePayload.license_state = normalized.license_state;\nif (!profile.years_experience && Number.isInteger(normalized.years_experience)) updatePayload.years_experience = normalized.years_experience;\nif (!profile.availability && normalized.availability) updatePayload.availability = normalized.availability;\nif (!profile.shift_preference && normalized.shift_preference) updatePayload.shift_preference = normalized.shift_preference;\nif (!profile.bio && normalized.bio) updatePayload.bio = normalized.bio;\nif (!existingCerts.length && normalized.certifications.length) updatePayload.certifications = normalized.certifications;\n\nreturn [{\n  json: {\n    ...base,\n    parsedResume: normalized,\n    updatePayload\n  }\n}];"
      },
