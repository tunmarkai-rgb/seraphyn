    {
      "parameters": {
        "promptType": "define",
        "text": "=You extract structured nurse resume data for Seraphyn. Use the nurse profile context when helpful, but never overwrite explicit resume facts with guesses. Use null when a value is not explicit. certifications and skills must be arrays of strings. years_experience must be an integer only when clearly inferable. Do not invent license numbers, specialties, states, dates, email addresses, or phone numbers. Existing nurse profile context:\\n{{ JSON.stringify($json.nurseProfile || {}, null, 2) }}\\n\\nResume text:\\n{{ $json.trimmedResumeText }}",
        "hasOutputParser": true,
        "options": {}
      },
